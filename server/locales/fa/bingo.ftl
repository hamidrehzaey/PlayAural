game-name-bingo = بینگو

bingo-pattern-line = هر خطی
bingo-pattern-four-corners = چهار گوشه
bingo-pattern-letter-x = حرف X
bingo-pattern-blackout = کل کارت

bingo-call-interval-5 = ۵ ثانیه
bingo-call-interval-15 = ۱۵ ثانیه
bingo-call-interval-30 = ۳۰ ثانیه
bingo-call-interval-45 = ۴۵ ثانیه
bingo-call-interval-60 = ۶۰ ثانیه

bingo-set-pattern = الگوی برنده: { $pattern }
bingo-select-pattern = الگوی برنده را انتخاب کنید:
bingo-option-changed-pattern = الگوی برنده اکنون { $pattern } است.
bingo-desc-pattern = شکلی که برای بردن نیاز است. «هر خطی» یعنی یک سطر، ستون یا قطر کامل. «چهار گوشه» به همه چهار مربع گوشه نیاز دارد. «حرف X» به هر دو قطر نیاز دارد. «کل کارت» به همه خانه‌ها نیاز دارد.

bingo-set-call-interval = سرعت خواندن: { $seconds }
bingo-select-call-interval = سرعت خواندن را انتخاب کنید:
bingo-option-changed-interval = سرعت هدف برای خواندن اکنون { $seconds } است.
bingo-desc-call-interval = زمان هدف بین خواندن دو شماره. بازی همیشه فرصت کوتاهی برای اعلام بینگو می‌دهد، بنابراین سریع‌ترین حالت ممکن است کمی بیشتر طول بکشد.

bingo-cell-free = مرکز آزاد، به طور خودکار علامت خورد.
bingo-cell-marked = { $letter } { $number }، علامت خورد.
bingo-cell-unmarked = { $letter } { $number }، علامت نخورده است.
bingo-cell-is-free = مرکز آزاد از قبل علامت خورده است.
bingo-you-already-won = شما از قبل در این دور بینگو شده‌اید.

bingo-you-mark = علامت زد: { $letter } { $number }.
bingo-you-unmark = علامت را برداشت: { $letter } { $number }.

bingo-claim-bingo = بگو بینگو!
bingo-repeat-call = تکرار شماره آخر
bingo-check-called = مشاهده شماره‌های خوانده‌شده
bingo-no-calls-yet = هنوز هیچ شماره‌ای خوانده نشده است.
bingo-claim-in-progress = یک ادعای بینگوی دیگر در حال بررسی است. لحظه‌ای دیگر دوباره امتحان کنید.
bingo-claim-in-progress-you = ادعای بینگوی شما از قبل در حال بررسی است.
bingo-claim-wait-for-call = صبر کنید تا شماره کشیده شده اعلام شود، سپس دوباره امتحان کنید.
bingo-claim-unchanged = کارت شما از زمان آخرین بررسی ناموفق تغییری نکرده است. قبل از اینکه دوباره بگویید بینگو، یک علامت را تغییر دهید یا منتظر شماره بعدی باشید.
bingo-checking-claim-you = شما گفتید بینگو! در حال بررسی کارت شما...
bingo-checking-claim = { $player } گفت بینگو! در حال بررسی کارت...
bingo-whose-turn-checking = در حال بررسی کارت { $player }...
bingo-whose-turn-checking-you = کارت شما در حال بررسی است...
bingo-whose-turn-checking-card = یک کارت بینگو در حال بررسی است...
bingo-whose-turn-drawing = شماره بعدی در حال کشیده شدن است...
bingo-whose-turn-waiting = { $seconds ->
    [one] شماره بعدی در { $seconds } ثانیه.
   *[other] شماره بعدی در { $seconds } ثانیه.
}
bingo-claim-incorrect-you = کارت شما هنوز بینگوی معتبری ندارد.
bingo-claim-incorrect = کارت { $player } هنوز بینگوی معتبری ندارد.
bingo-claim-incomplete-you = کارت شما هنوز الگوی برنده را کامل نکرده است.
bingo-claim-incomplete = کارت { $player } هنوز الگوی برنده را کامل نکرده است.
bingo-marked-number-not-called = شما { $letter } { $number } را علامت زدید، اما آن شماره هنوز خوانده نشده است.

bingo-last-call = آخرین شماره: { $letter } { $number }

bingo-status-called-count = خوانده شده: { $count } از { $total } شماره.
bingo-status-called-entry = { $letter } { $number }

bingo-game-start = بینگو شروع می‌شود! الگوی برنده { $pattern } است. شماره‌ها با سرعت یک عدد در هر { $interval } ثانیه خوانده می‌شوند و بعد از هر بار خواندن فرصتی برای گفتن بینگو وجود دارد. کارت خود را علامت بزنید و وقتی آماده بودید B را فشار دهید.
bingo-game-start-touch = بینگو شروع می‌شود! الگوی برنده { $pattern } است. شماره‌ها با سرعت یک عدد در هر { $interval } ثانیه خوانده می‌شوند و بعد از هر بار خواندن فرصتی برای گفتن بینگو وجود دارد. کارت خود را علامت بزنید و سپس از ژست لمس طولانی روی کارت استفاده کنید یا بگو بینگو را انتخاب کنید.
bingo-game-start-spectator = بینگو شروع می‌شود! الگوی برنده { $pattern } است. شماره‌ها با سرعت یک عدد در هر { $interval } ثانیه خوانده می‌شوند و بعد از هر بار خواندن فرصتی برای گفتن بینگو وجود دارد.
bingo-number-called = { $letter } { $number }

bingo-claim-correct-you = بینگو! شما با { $numbers } برنده شدید!
bingo-claim-correct = بینگو! { $player } با { $numbers } برنده شد!
bingo-claim-correct-no-numbers-you = بینگو! شما برنده شدید!
bingo-claim-correct-no-numbers = بینگو! { $player } برنده شد!
bingo-deck-exhausted = همه ۷۵ شماره خوانده شدند و هیچ‌کس بینگوی معتبری نداشت. این دور بدون برنده به پایان می‌رسد.

bingo-error-invalid-interval = "{ $value }" یک سرعت خواندن معتبر نیست.
bingo-error-invalid-pattern = { $value } یک الگوی برنده شناخته‌شده نیست.

bingo-end-calls = { $count ->
    [one] { $count } شماره در این دور خوانده شد.
   *[other] { $count } شماره در این دور خوانده شدند.
}
bingo-end-winner-line = برنده: { $player }
bingo-end-no-winner = هیچ‌کس در این دور بینگوی معتبری نداشت.
