monopoly-status-summary-player = { $player }: در مکان { $space }؛ { $cash }؛ { $properties } ملک

# Status views and results
monopoly-your-cash = شما { $cash } دارید.
monopoly-current-space-ownable = موقعیت { $position }: { $deed } بازیکنان حاضر: { $players }.
monopoly-current-space-other = موقعیت { $position }: { $space }؛ نوع: { $kind }؛ بازیکنان حاضر: { $players }.
monopoly-board-space-row = موقعیت { $position }: { $space }؛ بازیکنان حاضر: { $players }.
monopoly-board-ownable-row = موقعیت { $position }: { $space }؛ { $group }؛ مالک: { $owner }؛ { $state }؛ بازیکنان حاضر: { $players }.
monopoly-bank-supply = تامین بانک: { $houses } خانه و { $hotels } هتل.
monopoly-free-parking-pot = جک‌پات در { $space }: { $amount }.
monopoly-portfolio-player = { $player }؛ پول نقد: { $cash }؛ ارزش خالص تخمینی: { $net_worth }؛ مکان: { $space }؛ وضعیت: { $status }؛ کارت‌های آزادی از زندان: { $jail_cards }.
monopoly-buying-eligibility = خرید ملک: { $eligible ->
