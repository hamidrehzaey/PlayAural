monopoly-trade-summary-target = { $proposer } می‌دهد: { $offered }؛ شما می‌دهید: { $requested }.
monopoly-trade-review-property = { $player } دریافت می‌کند: { $deed } { $mortgaged ->
    [yes] حداقل بهره انتقال فوری: { $interest }.
   *[no] بدون بهره انتقال.
}
monopoly-jail-card-count = { $count ->
    [one] یک کارت آزادی از زندان
   *[other] { $count } کارت آزادی از زندان
}

