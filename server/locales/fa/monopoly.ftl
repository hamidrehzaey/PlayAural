monopoly-current-space-other = موقعیت { $position }: { $space }؛ نوع: { $kind }؛ بازیکنان حاضر: { $players }.
monopoly-board-space-row = موقعیت { $position }: { $space }؛ بازیکنان حاضر: { $players }.
monopoly-board-ownable-row = موقعیت { $position }: { $space }؛ { $group }؛ مالک: { $owner }؛ بازیکنان حاضر: { $players }.
monopoly-board-portfolio-row = { $property }؛ { $group }؛ { $status }
monopoly-status-player-row = { $player }: { $cash }؛ مکان: { $position } ({ $space })؛ { $properties } ملک؛ دارایی خالص: { $net_worth }؛ وضعیت: { $state }.
