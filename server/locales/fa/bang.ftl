bang-player-copies-character = { $player } شخصیت { $character } را تا نوبت بعدی خود کپی می‌کند.
bang-you-win-game = شما برنده شدید. سمت برنده: { $side }. برنده‌ها: { $winners }.
bang-you-lose-game = شما باختید. سمت برنده: { $side }. برنده‌ها: { $winners }.
bang-game-over = بازی تمام شد. سمت برنده: { $side }. برنده‌ها: { $winners }.
bang-end-side = سمت برنده: { $side }
bang-end-player = { $rank }. { $player }، { $role }، { $character }، برنده: { $winner ->
    [yes] بله
   *[no] خیر
}.

bang-source-bang-card = BANG!
bang-source-missed-as-bang = Missed! استفاده شده به عنوان BANG!
bang-source-doc-holyday = Doc Holyday
bang-source-sniper = تک‌تیرانداز
bang-source-punch = مشت
bang-source-springfield = Springfield
bang-source-buffalo-rifle = Buffalo Rifle
bang-source-knife = چاقو
bang-source-pepperbox = Pepperbox
bang-source-derringer = Derringer
bang-source-gatling = Gatling
bang-source-howitzer = Howitzer
bang-source-ricochet = Ricochet
bang-source-russian-roulette = رولت روسی
bang-source-fistful-of-cards = یک مشت کارت
bang-source-duel = دوئل
bang-source-indians = سرخپوستان!
bang-source-dynamite = دینامیت
bang-source-high-noon = ظهر (High Noon)
bang-source-by-player = حمله { $source } توسط { $player }

bang-target-mode-discard = دور انداختن
bang-target-mode-steal = گرفتن
bang-draw-requirement-barrel = دل (Hearts) به عنوان یک اثر Missed! موفق می‌شود
bang-draw-requirement-dynamite = پیک (Spades) ۲ تا ۹ منفجر می‌شود
bang-draw-requirement-jail = دل (Hearts) مانع از دست دادن نوبت می‌شود
bang-draw-requirement-vendetta = دل (Hearts) یک نوبت اضافی می‌دهد
bang-kit-action-keep = نگه داشتن
bang-kit-action-return = برگرداندن به دسته کارت‌ها
bang-prompt-play-turn = یک کارت، یک قابلیت یا پایان نوبت را انتخاب کنید.
bang-prompt-law-required = قانون غرب (Law of the West) شما را ملزم می‌کند کارت { $card } را بازی کنید، تا زمانی که یک بازی قانونی دارد.
bang-prompt-play-handcuffs-suit = دستبند (Handcuffs) فقط اجازه کارت‌های { $suit } را می‌دهد. یک کارت قانونی، قابلیت یا پایان نوبت را انتخاب کنید.
bang-prompt-select-single-cost = 1 کارت را برای { $action } انتخاب کنید.
bang-prompt-cost-ready = اقدام { $action }: انتخاب آماده است. تأیید کنید یا یک کارت را لغو انتخاب کنید.
bang-prompt-select-cost = { $selected ->
    [0] { $required } کارت را برای { $action } انتخاب کنید.
   *[other] اقدام { $action }: { $selected } مورد انتخاب شد؛ { $remaining } مورد دیگر انتخاب کنید.
}
bang-prompt-select-target = اقدام { $action }: یک هدف انتخاب کنید، یا لغو را بزنید.
bang-prompt-select-ricochet-owner = اقدام { $action }: یک بازیکن را انتخاب کنید، یا لغو را بزنید.
bang-prompt-select-in-play = اقدام { $action }: یک کارت رو شده مقابل { $target } را انتخاب کنید، یا لغو را بزنید.
bang-prompt-barrel = حمله { $source }: یک بررسی بشکه امتحان کنید یا به کارت‌های پاسخ ادامه دهید. { $remaining ->
    [one] هنوز 1 اثر Missed! لازم است.
   *[other] هنوز { $remaining } اثر Missed! لازم است.
}
bang-prompt-missed = پاسخ به { $source }: { $remaining ->
    [one] 1 اثر Missed! دیگر بازی کنید
   *[other] { $remaining } اثر Missed! دیگر بازی کنید
} یا { $damage } آسیب دریافت کنید.
bang-prompt-duel = دوئل با { $opponent }: یک کارت BANG! را دور بیندازید یا متوقف شوید و یک جان از دست بدهید.
bang-prompt-indians = پاسخ به { $source }: یک کارت BANG! را دور بیندازید یا یک جان از دست بدهید.
bang-prompt-lethal-recovery = جان: { $life }. از آبجو یا Sid Ketchum برای رسیدن به 1 استفاده کنید، یا حذف شدن را بپذیرید.
bang-prompt-lucky-duke = Lucky Duke: یک کارت انتخاب کنید. { $requirement }.
bang-prompt-general-store = { $count ->
    [one] آخرین کارت فروشگاه عمومی را بردارید.
   *[other] یکی از { $count } کارت فروشگاه عمومی را انتخاب کنید.
}
bang-prompt-target-card = { $target }: یک کارت تصادفی دست یا یک کارت بازی شده را برای { $mode } انتخاب کنید.
bang-prompt-ricochet = پاسخ به { $source }: یک اثر Missed! بازی کنید یا اجازه دهید کارت { $card } دور انداخته شود.
bang-prompt-vulture = کارت بعدی Vulture Sam را از { $player } انتخاب کنید.
bang-prompt-elimination-discard = { $remaining ->
    [one] 1 کارت باقی مانده است. آن را برای دسته دور انداخته شده انتخاب کنید، یا با ترتیب فعلی منو پایان دهید.
   *[other] { $remaining } کارت باقی مانده است. کارت بعدی را برای دسته دور انداخته شده انتخاب کنید، یا با ترتیب فعلی منو پایان دهید.
}
bang-prompt-daltons = برادران دالتون (The Daltons): یک کارت آبی جلوی خود را برای دور انداختن فوری انتخاب کنید.
bang-you-discard-daltons = شما { $card } را برای The Daltons دور می‌اندازید.
bang-player-discards-daltons = { $player } کارت { $card } را برای The Daltons دور می‌اندازد.
bang-prompt-blood-brothers = یک جان غیرنهایی از دست بدهید تا یک بازیکن را درمان کنید، یا رد شوید.
bang-prompt-new-identity = شخصیت خود را نگه دارید، یا با دو جان به شخصیت جایگزین تغییر دهید.
bang-prompt-vera-custer = یک شخصیت زنده را برای کپی کردن تا نوبت بعدی خود انتخاب کنید.
bang-prompt-hard-liquor = به طور عادی کارت بکشید، یا برای بازیابی 1 جان از کارت کشیدن صرف‌نظر کنید.
bang-prompt-jesse-jones = به طور عادی کارت بکشید، یا 1 کارت تصادفی از دست یک بازیکن بگیرید.
bang-prompt-pedro-ramirez = بالاترین کارت دور انداخته شده را بردارید، یا از دسته اصلی کارت بکشید.
bang-prompt-pat-brennan = به طور عادی کارت بکشید، یا 1 کارت از بازی بگیرید.
bang-prompt-kit-carlson = کارت بررسی شده را برای { $action } انتخاب کنید.
bang-prompt-claus-give = یک کارت را انتخاب کنید تا بلافاصله به { $target } بدهید.
bang-prompt-peyote = حدس بزنید که کارت بعدی قرمز است یا مشکی.
bang-prompt-handcuffs = تنها خالی که می‌توانید در این نوبت بازی کنید را انتخاب کنید.
bang-prompt-ranch = { $selected ->
    [0] کارت‌هایی را برای تعویض انتخاب کنید، یا برای نگه داشتن دست خود تأیید کنید.
   *[other] { $selected } کارت انتخاب شد؛ بیشتر انتخاب کنید یا تأیید کنید.
}
bang-prompt-discard-single = 1 کارت اضافی دست را انتخاب کنید تا دور بیندازید و نوبت خود را بلافاصله تمام کنید.
bang-prompt-discard-ready = کارت‌های اضافی به تعداد { $required } را دور بیندازید. آماده تأیید یا تغییر انتخاب است.
bang-prompt-discard-excess = { $selected ->
    [0] تعداد { $required } کارت اضافی را به ترتیب دور بیندازید: اولی را انتخاب کنید.
   *[other] تعداد { $required } کارت اضافی را به ترتیب دور بیندازید: { $selected } مورد انتخاب شد؛ { $remaining } مورد دیگر انتخاب کنید.
}

bang-error-base-player-count = کارت‌ها و شخصیت‌های گسترش‌یافته باید برای 3 یا 8 بازیکن روشن باشند. آن را روشن کنید یا از 4 تا 7 بازیکن استفاده کنید.
bang-error-event-mode = این حالت رویداد در دسترس نیست. گزینه لابی دیگری را انتخاب کنید.
bang-error-not-player = فقط یک بازیکن نشسته در بازی BANG! می‌تواند این کار را انجام دهد.
bang-error-card-missing = این کارت جابجا شد. از منوی فعلی استفاده کنید.
bang-error-card-not-response = این کارت نمی‌تواند به این تهدید پاسخ دهد. یک پاسخ در دسترس را انتخاب کنید.
bang-error-card-is-main-cost = کارتی که بازی شده است نمی‌تواند هزینه اضافی خود را نیز بپردازد. کارت دیگری انتخاب کنید.
bang-error-card-not-valid-cost = این کارت هزینه معتبری نیست. یک کارت از فهرست شده‌ها انتخاب کنید.
bang-error-law-card-as-cost = قانون غرب (Law of the West) مستلزم این است که کارت فاش شده بازی شود، نه اینکه به عنوان هزینه دیگری صرف شود.
bang-error-not-your-turn = نوبت { $player } است. شما هنوز می‌توانید دست خود یا میز را بخوانید.
bang-error-not-target = پاسخ شما لازم نیست.
bang-error-already-responded = پاسخ شما قبلاً به این تهدید ارسال شده است.
bang-error-must-respond = منتظر تایید است. به آن پاسخ دهید، آسیب را بپذیرید یا یک کارت را برای رد کردن انتخاب کنید.
bang-error-choice-invalid = این انتخاب دیگر در دسترس نیست. از منوی فعلی یک گزینه انتخاب کنید.
bang-error-target-invalid = این بازیکن نمی‌تواند برای آن اقدام هدف قرار گیرد.
bang-error-card-unselected = آن کارت قبلاً انتخاب نشده است.
bang-error-not-enough-selected = این اقدام به تعداد دقیق { $required } کارت نیاز دارد.
bang-error-card-owner = کارت انتخاب شده در بازی، متعلق به بازیکن هدف نیست.
bang-error-ghost-target = آن بازیکن در حال حاضر یک روح شهر ارواح است و نمی‌تواند هدف قرار گیرد.
bang-error-ranch-requires-exchange = شما هیچ کارتی را برای مزرعه (Ranch) انتخاب نکرده‌اید تا تعویض کنید.
bang-error-play-limit = شما نمی‌توانید در این نوبت از BANG! دیگری استفاده کنید.
bang-error-cannot-play-card = آن کارت در حال حاضر قابل بازی نیست.
bang-error-must-play-law = قانون غرب (Law of the West) مستلزم این است که در صورت امکان کارت فاش شده را بازی کنید.
bang-error-event-blocked-play = قانون یک رویداد از بازی کردن آن کارت جلوگیری می‌کند.
bang-error-character-blocked = یک توانایی شخصیت از آن اقدام جلوگیری می‌کند.
bang-error-target-out-of-range = آن بازیکن خارج از محدوده هدف‌گیری { $range } است.
bang-error-target-in-play-duplicate = هدف قبلاً کارتی به آن نام در بازی دارد.
bang-error-in-play-duplicate = شما قبلاً کارتی به آن نام در بازی دارید.
bang-error-action-requires-hand = این اقدام به یک کارت از دست نیاز دارد.
bang-error-action-requires-in-play = این اقدام به یک کارت از بازی نیاز دارد.
bang-error-hand-full = دست شما پر است؛ این ویژگی در حال حاضر نمی‌تواند استفاده شود.
bang-error-cannot-discard-to-heal = این توانایی در حال حاضر نمی‌تواند شما را درمان کند.
bang-error-action-rejected-by-server = سرور این اقدام را رد کرد. این ممکن است یک باگ باشد.

bang-error-no-active-turn = هنوز هیچ نوبتی فعال نیست. منتظر بمانید تا صحنه آغازین یا حل و فصل فعلی پایان یابد.
bang-error-intro-playing = صحنه آغازین هنوز در حال پخش است. نوبت اول زمانی آغاز می‌شود که این صحنه پایان یابد.
bang-error-your-turn-start = اثرات شروع نوبت شما هنوز در حال حل و فصل است. انتخاب فعلی را کامل کنید.
bang-error-player-turn-start = { $player } در حال حل و فصل اثرات شروع نوبت است.
bang-error-your-draw-resolving = مرحله کشیدن کارت شما هنوز در حال حل و فصل است. انتخاب فعلی را کامل کنید.
bang-error-player-draw-resolving = { $player } در حال حل و فصل مرحله کشیدن کارت است.
bang-error-effect-resolving = اثر فعلی هنوز در حال حل و فصل است. پاسخ یا انتخاب نمایش داده شده را کامل کنید.
bang-error-effect-resolving-source = { $source } هنوز در حال حل و فصل است. پاسخ یا انتخاب نمایش داده شده را کامل کنید.
bang-error-audio-sequence = اقدام هنوز در حال اجرا است. یک لحظه صبر کنید.
bang-error-finish-decision = پاسخ یا انتخاب فعلی را کامل کنید.
bang-error-finish-selection = بازی فعلی را کامل یا لغو کنید.
bang-error-must-discard = کارت‌های اضافی کافی را انتخاب کنید، سپس تأیید کنید.
bang-error-player-must-discard = { $player } برای پایان دادن به نوبت باید کارت‌های اضافی دست خود را دور بیندازد.
bang-error-response-only = { $card } فقط به عنوان پاسخ است و در حال حاضر نمی‌توان آن را بازی کرد.
bang-error-handcuffs-suit = دستبند (Handcuffs) فقط اجازه می‌دهد در این نوبت کارت‌های { $suit } بازی شوند، بنابراین شما نمی‌توانید { $card} را بازی کنید.
bang-error-bang-limit = شما قبلاً تعداد مجاز { $limit } کارت BANG! را در این نوبت بازی کرده‌اید.
bang-error-sermon-bang = موعظه (Sermon) مانع از استفاده بازیکن فعال از کارت‌های BANG! در طول این نوبت می‌شود.
bang-error-reverend-beer = کشیش (Reverend) مانع از بازی شدن کارت‌های آبجو (Beer) می‌شود.
bang-error-judge-in-play = قاضی (Judge) مانع از آن می‌شود که هر بازیکنی کارت‌های آبی یا سبز را در بازی قرار دهد.
bang-error-duplicate-in-play = شما از قبل { $card } را در مقابل خود دارید؛ نام‌های تکراری مجاز نیستند.
bang-error-duplicate-dynamite = شما از قبل یک دینامیت در مقابل خود دارید.
bang-error-no-legal-target = { $card } هیچ هدف مجازی ندارد. بازی دیگری انتخاب کنید.
bang-error-no-reachable-target = هیچ‌کس در برد سلاح نیست. سلاح‌ها را تغییر دهید، بازی دیگری انتخاب کنید، یا نوبت خود را به پایان برسانید.
bang-error-extra-cost = { $card } به ۱ کارت دست دیگر به عنوان هزینه نیاز دارد.
bang-error-green-not-ready = یک کارت سبز باید تا نوبت بعدی برای استفاده صبر کند.
bang-error-in-play-disabled = رویداد فعلی یا بل استار (Belle Star) آن کارت در حال بازی را غیرفعال می‌کند.
bang-error-not-green = فقط کارت‌های سبز برای استفاده از اثر در حال بازی خود مصرف می‌شوند.
bang-error-full-life = شما در حال حاضر در حداکثر جان خود هستید.
bang-error-sid-character-only = فقط سید کچام (Sid Ketchum) می‌تواند از این توانایی استفاده کند.
bang-error-sid-timing = سید کچام می‌تواند بین کارت‌های حل و فصل شده یا در طول بازیابی مرگبار خود شفا یابد.
bang-error-sid-needs-two = سید کچام حداقل به دو کارت دست نیاز دارد و باید دقیقاً دو کارت دور بیندازد.
bang-error-doc-used = داک هالیدی (Doc Holyday) قبلاً در این نوبت از توانایی خود استفاده کرده است.
bang-error-doc-needs-two = داک هالیدی حداقل به دو کارت دست نیاز دارد و باید دقیقاً دو کارت دور بیندازد.
bang-error-chuck-last-life = چاک ونگام (Chuck Wengam) نمی‌تواند آخرین نقطه جان خود را خرج کند.
bang-error-jose-used = خوزه دلگادو (José Delgado) فقط دو بار در نوبت می‌تواند استفاده شود.
bang-error-jose-needs-blue = خوزه دلگادو به یک کارت آبی در دست شما نیاز دارد.
bang-error-uncle-used = عمو ویل (Uncle Will) قبلاً در این نوبت استفاده شده است.
bang-error-sniper-needs-two = تک‌تیرانداز به حداقل دو کارت BANG! نیاز دارد و باید دقیقاً دو کارت دور بیندازد.
bang-error-ricochet-needs-bang = کمانه (Ricochet) به یک کارت BANG! برای دور انداختن نیاز دارد.
bang-error-no-in-play-card = هیچ کارتی در بازی برای هدف‌گیری وجود ندارد.
bang-error-select-more-cards = کارت‌های مورد نیاز باقی‌مانده را انتخاب کنید، سپس تأیید کنید.
bang-error-select-target = آن هدف دیگر مجاز نیست؛ هدف دیگری انتخاب کنید یا اقدام را لغو کنید.
bang-error-select-in-play-target = آن کارت دیگر هدف مجازی نیست؛ کارت دیگری انتخاب کنید یا اقدام را لغو کنید.
bang-error-selection-limit = فقط { $required } کارت مورد نیاز است. قبل از تغییر کارت‌ها، یکی را از انتخاب خارج کنید.
bang-error-confirm-not-open = چیزی برای تأیید آماده نیست. یک کارت، توانایی یا پایان نوبت را انتخاب کنید.
bang-error-nothing-to-cancel = هیچ انتخاب قابل بازگشتی برای لغو وجود ندارد.
bang-error-empty-hand = دست شما خالی است.
bang-error-law-card-required = قانون غرب (Law of the West) ایجاب می‌کند که شما { $card } را بازی کنید زیرا یک بازی مجاز دارد.
bang-waiting-action-choice = انتخاب نمایش داده شده را انجام دهید.
bang-waiting-intent-cost = { $remaining ->
    [one] 1 کارت دست دیگر
   *[other] { $remaining } کارت دست دیگر
} را برای پرداخت اقدام در حال انتظار انتخاب کنید، سپس تأیید یا لغو کنید.
bang-waiting-intent-cost-ready = پرداخت { $selected } کارتی اقدام در حال انتظار را تأیید کنید، آن را تغییر دهید، یا لغو کنید.
bang-waiting-intent-target = یک هدف مجاز برای اقدام در حال انتظار انتخاب کنید، یا لغو کنید.
bang-waiting-intent-in-play = یک کارت روی شده مجاز برای اقدام در حال انتظار انتخاب کنید، یا لغو کنید.
bang-error-waiting-for-player = در انتظار { $player}. اقدام مورد نیاز: { $action}
