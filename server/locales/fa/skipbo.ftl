
game-name-skipbo = Skip-Bo
skipbo-stock-mode-standard = استاندارد (30 یا 20 کارت)
skipbo-stock-mode-short = سریع 10 کارت
skipbo-stock-mode-short-15 = سریع 15 کارت
skipbo-scoring-single = تک بازی
skipbo-scoring-match = مسابقه گل خورده
skipbo-set-stock-mode = توده های انبار:{ $mode }
skipbo-select-stock-mode = طول شمع انبار را انتخاب کنید:
skipbo-option-changed-stock-mode = شمع های سهام در حال حاضر استفاده می شود{ $mode }.
skipbo-desc-stock-mode = استاندارد از 30 کارت سهام با 2 تا 4 بازیکن و 20 کارت با 5 یا 6 بازیکن استفاده می کند. بازی های سریع از 10 یا 15 کارت سهام برای هر بازیکن استفاده می کنند.
skipbo-set-scoring-mode = قالب مطابقت:{ $mode }
skipbo-select-scoring-mode = قالب مسابقه را انتخاب کنید:
skipbo-option-changed-scoring-mode = قالب مسابقه اکنون است{ $mode }.
skipbo-desc-scoring-mode = یک بازی زمانی به پایان می رسد که یک بازیکن یا شراکت انبارهای خود را خالی کند. مسابقه گل‌شده در تمام بازی‌ها ادامه می‌یابد تا زمانی که فردی به امتیاز هدف برسد.
skipbo-set-winning-score = هدف مسابقه:{ $score }امتیاز
skipbo-enter-winning-score = هدف مسابقه را از 25 تا 5000 امتیاز وارد کنید:
skipbo-option-changed-winning-score = هدف مسابقه اکنون است{ $score }امتیاز
skipbo-desc-winning-score = امتیازهای مورد نیاز برای پیروزی در یک مسابقه به ثمر رسیده است. هدف رسمی 500 امتیاز است.
skipbo-desc-team-mode = فردی به هر بازیکن یک انبار و امتیاز جداگانه می دهد. مشارکت های رسمی از تیم های دو نفره استفاده می کنند. شرکا ممکن است از سهام هر یک از طرفین بازی کنند و توده ها را دور بریزند، اما هرگز از دست یکدیگر.
skipbo-card-number = { $value }
skipbo-card-wild = Skip-Bo wild
skipbo-card-wild-as = Skip-Bo as{ $value }
skipbo-source-your-hand = دست تو
skipbo-source-player-hand = { $owner }دست
skipbo-source-your-stock = توده سهام شما
skipbo-source-player-stock = { $owner }توده سهام
skipbo-source-your-discard = توده دور انداختن شما{ $pile }
skipbo-source-player-discard = { $owner }شمع دور انداختن{ $pile }
skipbo-action-source-hand = دست
skipbo-action-source-stock = سهام
skipbo-action-source-player-stock = { $owner }سهام
skipbo-action-source-discard = دور انداختن توده{ $pile }
skipbo-action-source-player-discard = { $owner }شمع دور انداختن{ $pile }
skipbo-play-action = { $card } — { $source }انباشته کردن{ $pile }
skipbo-card-action = { $card } — { $source }
skipbo-card-desc-play-or-discard = شمع های ساختمانی موجود:{ $piles }. کارت را برای بازی انتخاب کنید یا آن را دور بیندازید و نوبت خود را تمام کنید.
skipbo-card-desc-discard-only = کارت را انتخاب کنید تا آن را دور بیندازید و به نوبت خود پایان دهید.
skipbo-card-desc-choose-building = شمع های ساختمانی موجود:{ $piles }. کارت را برای انتخاب یکی انتخاب کنید.
skipbo-end-turn-empty = پیچ را بدون دور انداختن پایان دهید
skipbo-end-turn-empty-desc = دست شما خالی است و هیچ کارتی قابل کشیدن نیست، بنابراین امکان رد کردن وجود ندارد.
skipbo-select-card-move = محل انتقال این کارت را انتخاب کنید:
skipbo-move-building-empty = شمع ساختمان{ $pile }: خالی بازی کردن{ $card }
skipbo-move-building-top = شمع ساختمان{ $pile }: { $current }در بالا؛ بازی کردن{ $card }
skipbo-move-discard-empty = شمع را دور بریزید{ $pile }: خالی اینجا را دور بریزید و به نوبت پایان دهید
skipbo-move-discard-top = شمع را دور بریزید{ $pile }: { $top }در بالا؛ اینجا را دور بریزید و به نوبت پایان دهید
skipbo-read-building-piles = مشاهده شمع های ساختمان
skipbo-read-stock-piles = مشاهده توده های سهام
skipbo-read-own-discard-piles = توده های دور ریختنی خود را مشاهده کنید
skipbo-read-discard-piles = انباشته های دور انداختن بازیکن دیگر را مشاهده کنید
skipbo-select-discard-owner = انتخاب کنید که انباشته‌های دور انداخته چه کسی مشاهده شود:
skipbo-game-start = بازی شروع می شود. هر شمع سهام دارد{ $stock_count }کارت ها
skipbo-game-start-quick = بازی سریع شروع می شود. هر شمع سهام دارد{ $stock_count }کارت ها
skipbo-match-game-start = بازی گل خورده{ $game }آغاز می شود. هر شمع سهام دارد{ $stock_count }کارت ها
skipbo-match-game-start-quick = بازی سریع به ثمر رسید{ $game }آغاز می شود. هر شمع سهام دارد{ $stock_count }کارت ها
skipbo-initial-stock-you = کارت سهام رو به بالا شما است{ $card }.
skipbo-initial-stock-player = { $player }کارت سهام رو به بالا است{ $card }.
skipbo-draw-turn-you =
    تو نقاشی میکشی{ $count } { $count ->
        [one] کارت
       *[other] کارت ها
    }برای شروع نوبت شما دست توست{ $hand }.
skipbo-draw-turn-player =
    { $player }قرعه کشی می کند{ $count } { $count ->
        [one] کارت
       *[other] کارت ها
    }برای شروع{ GENDER_TERM($player_gender, "possessive-determiner") }چرخش
skipbo-refill-you =
    شما از هر کارتی که در دست داشتید استفاده کردید، بنابراین بلافاصله می کشید{ $count } { $count ->
        [one] کارت
       *[other] کارت ها
    }. دست توست{ $hand }.
skipbo-refill-player =
    { $player }از هر کارتی استفاده کرد{ GENDER_TERM($player_gender, "possessive-determiner") }دست و بلافاصله رسم می کند{ $count } { $count ->
        [one] کارت
       *[other] کارت ها
    }.
skipbo-no-refill-you = دست شما خالی است و هیچ کارتی برای کشیدن در دسترس نیست.
skipbo-no-refill-player = { $player }دستش خالی است، اما هیچ کارتی برای کشیدن در دسترس نیست.
skipbo-recycle-completed = شمع قرعه کشی خالی است. شمع های ساختمان تکمیل شده به هم ریخته می شوند تا یک شمع رسم جدید با آن ایجاد شود{ $count }کارت ها
skipbo-play-you = تو بازی کن{ $card }از{ $source }به ساختن شمع{ $pile }.
skipbo-play-player = { $player }بازی می کند{ $card }از{ $source }به ساختن شمع{ $pile }.
skipbo-complete-building-you = شما شمع ساختمان را کامل می کنید{ $pile }در ساعت 12. کارت های آن برای جابجایی کنار گذاشته می شود و شکاف ساختمان دوباره خالی است.
skipbo-complete-building-player = { $player }شمع ساختمان را کامل می کند{ $pile }در ساعت 12. کارت های آن برای جابجایی کنار گذاشته می شود و شکاف ساختمان دوباره خالی است.
skipbo-next-stock-you =
    کارت سهام رو به بالا بعدی شما است{ $card }; { $count } { $count ->
        [one] کارت باقی می ماند
       *[other] کارت ها باقی می ماند
    }در توده سهام شما
skipbo-next-stock-player =
    { $player }کارت سهام رو به بالا بعدی است{ $card }; که توده سهام دارد{ $count } { $count ->
        [one] کارت باقی می ماند
       *[other] کارت ها باقی می ماند
    }.
skipbo-stock-cleared-you = انبار سهام شما اکنون خالی است. شراکت شما هنوز باید توده سهام دیگر را خالی کند.
skipbo-stock-cleared-player = { $player }انبار سهام اکنون خالی است. شراکت هنوز باید انبار دیگر سهام خود را خالی کند.
skipbo-discard-you = شما دور می اندازید{ $card }روی شمع دور ریختن{ $pile }و نوبت خود را تمام کن
skipbo-discard-player = { $player }دور می اندازد{ $card }روی شمع دور ریختن{ $pile }و به پایان می رسد{ GENDER_TERM($player_gender, "possessive-determiner") }چرخش
skipbo-empty-end-you = هیچ کارتی برای دور انداختن ندارید، بنابراین نوبت خود را بدون کارت به پایان می‌رسانید.
skipbo-empty-end-player = { $player }کارتی برای دور انداختن ندارد و به پایان می رسد{ GENDER_TERM($player_gender, "possessive-determiner") }بدون یکی بچرخد
skipbo-single-win-you = توده های سهام خود را خالی می کنید و برنده بازی می شوید.
skipbo-single-win-player = { $player }خالی می کند{ GENDER_TERM($player_gender, "possessive-determiner") }سهام انباشته و برنده بازی است.
skipbo-single-win-team-you = شراکت شما هم توده های سهام را خالی می کند و هم برنده بازی است.
skipbo-single-win-team = تیم{ $team }هر دو انبوه سهام را خالی می کند و برنده بازی است.
skipbo-scored-game-win-you = توده‌های سهام خود را خالی می‌کنید و برنده بازی امتیازدهی می‌شوید{ $game }، کسب درآمد{ $points }امتیاز با{ $remaining }در سراسر انبوه سهام مخالف باقی مانده است. مجموع مسابقه شما است{ $total }.
skipbo-scored-game-win-player = { $player }خالی می کند{ GENDER_TERM($player_gender, "possessive-determiner") }انباشت سهام و برنده بازی به ثمر رساند{ $game }، کسب درآمد{ $points }امتیاز با{ $remaining }در سراسر انبوه سهام مخالف باقی مانده است. مجموع مسابقه است{ $total }.
skipbo-scored-game-win-team-you = شراکت شما هم انباشته سهام را خالی می کند و هم بازی را که به ثمر رسیده است{ $game }، کسب درآمد{ $points }امتیاز با{ $remaining }در سراسر انبوه سهام مخالف باقی مانده است. مجموع مسابقه شما است{ $total }.
skipbo-scored-game-win-team = تیم{ $team }هم انبوه سهام را خالی می کند و هم بازی گل شده را برد{ $game }، کسب درآمد{ $points }امتیاز با{ $remaining }در سراسر انبوه سهام مخالف باقی مانده است. مجموع مسابقات این تیم است{ $total }.
skipbo-next-round = بازی بعدی گل زده به زودی آغاز خواهد شد. موقعیت شروع یک صندلی به جلو حرکت می کند.
skipbo-match-win-you = شما برنده مسابقه Skip-Bo با{ $score }امتیاز
skipbo-match-win-player = { $player }برنده مسابقه Skip-Bo با{ $score }امتیاز
skipbo-match-win-team-you = شراکت شما برنده مسابقه Skip-Bo با{ $score }امتیاز
skipbo-match-win-team = تیم{ $team }برنده مسابقه Skip-Bo با{ $score }امتیاز
skipbo-building-empty = شمع ساختمان{ $pile }: خالی نیاز 1.
skipbo-building-top = شمع ساختمان{ $pile }: { $value }در بالا؛ نیاز دارد{ $needed }.
skipbo-draw-count = رسم شمع:{ $draw_count }کارت ها کارت های ساختمان تکمیل شده در انتظار تغییر:{ $recycle_count }.
skipbo-stock-empty = { $player }انبوه انبار: خالی.
skipbo-stock-status =
    { $player }توده سهام:{ $card }رو به بالا،{ $count } { $count ->
        [one] کل کارت
       *[other] کل کارت ها
    }.
skipbo-discard-your-header = توده های دور ریختنی شما:
skipbo-discard-player-header = { $player }توده های دور ریختنی:
skipbo-discard-empty = شمع را دور بریزید{ $pile }: خالی
skipbo-discard-top =
    شمع را دور بریزید{ $pile }: { $card }در بالا،{ $count } { $count ->
        [one] کل کارت
       *[other] کل کارت ها
    }.
skipbo-hand-empty = شما هنوز هیچ کارتی در دست ندارید.
skipbo-hand-menu-card = دست:{ $card }
skipbo-error-invalid-stock-mode = طول شمع سهام انتخاب شده پشتیبانی نمی شود. استاندارد، Quick 10 یا Quick 15 را انتخاب کنید.
skipbo-error-invalid-scoring-mode = قالب منطبق انتخابی پشتیبانی نمی شود. تک بازی یا مسابقه امتیازی را انتخاب کنید.
skipbo-error-winning-score-range = هدف مسابقه باید از{ $min }به{ $max }امتیاز؛ در حال حاضر است{ $value }.
skipbo-error-partnership-player-count = مشارکت دقیقاً به 4 بازیکن برای دو شراکت یا 6 بازیکن برای سه شراکت نیاز دارد.
skipbo-error-game-not-active = این بازی Skip-Bo در حال حاضر فعال نمی باشد.
skipbo-error-round-transition = بازی فعلی به پایان رسیده است. منتظر شروع بازی بعدی باشید.
skipbo-error-card-move-selection-you = ابتدا محل انتقال کارت انتخابی را انتخاب کنید.
skipbo-error-play-changed = این بازی دیگر در دسترس نیست زیرا کارت یا توده ساختمان تغییر کرده است. یک عملکرد منوی نوبت فعلی را انتخاب کنید.
skipbo-error-card-changed = آن کارت دیگر در دسترس نیست. یک عملکرد منوی نوبت فعلی را انتخاب کنید.
skipbo-error-cards-available = هنوز کارتی برای دور انداختن در دسترس دارید. نوبت خود را با انتخاب آن کارت و یکی از چهار انبوه دور انداختن خود پایان دهید.
skipbo-error-no-discard-targets = هیچ شمع دور انداختن بازیکن دیگری در دسترس نیست.
skipbo-error-discard-target-changed = انباشته های دور ریختنی آن بازیکن دیگر در دسترس نیستند. بازیکن فعلی را انتخاب کنید
skipbo-discard-owner-unavailable = پخش کننده دیگر در دسترس نیست
skipbo-result-line = { $rank }. { $player }: { $points }
